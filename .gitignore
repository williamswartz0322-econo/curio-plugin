.env
.env.*

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node (bridge/dist is committed on purpose: the MCP server runs without npm install)
node_modules/
.next/
out/
app/tsconfig.tsbuildinfo

# OS
.DS_Store
